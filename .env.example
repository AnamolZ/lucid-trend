# MongoDB Database Settings
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
DATABASE_NAME=portfolio_db
COLLECTION_NAME=posts

# Multi-Key & Model Setup (Comma-separated keys supported for automated failover)
GOOGLE_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-3.7-flash

# SMTP Email Relay Configuration (Brevo / SendGrid / Postmark)
SMTP_SERVER=smtp-relay.brevo.com
SMTP_USER=your_smtp_login@smtp-brevo.com
SMTP_PASSWORD=your_smtp_relay_key

# Image Generation Credentials (comma-separated keys supported for automated rotation)
HUGGING_FACE_TOKENS=hf_token_1,hf_token_2
HUGGING_FACE_TOKEN=hf_your_hugging_face_token

# Redis Task Broker (Defaults to localhost outside Docker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Management API & CLI Authentication Key
API_SECRET_KEY=lt_sec_your_secret_api_key_here
MASTER_PASSWORD=lucidtrend1379
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
